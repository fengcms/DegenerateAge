; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="末法纪元：最后的守护者"
config/description="2D 等距斜角（isometric）单机实时战斗 ARPG。引擎：Godot 4，语言：GDScript。"
config/version="0.1.0-scaffold"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Localization="*res://autoload/localization.gd"
GameState="*res://autoload/game_state.gd"
DataLoader="*res://autoload/data_loader.gd"
SaveManager="*res://autoload/save_manager.gd"
QuestService="*res://autoload/quest_service.gd"
MapService="*res://autoload/map_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
; ⚠ 实际渲染策略在运行时由 SettingsRuntime.apply_display_strategy() 设为 disabled（M5-9a，工程 17）。
; 这里必须保持 canvas_items：无头运行时 dummy 显示驱动报告窗口尺寸 0×0，而 disabled 的视口
; 尺寸源自窗口 ⇒ 根视口塌成 64×64，会让依赖 get_viewport_rect() 的 Game.visible_enemies()
; 与 T 系列冒烟误判失败。无头保持 canvas_items 可让视口取本处 1280×800。
; ⚠ 注意：OS.has_feature("headless") 恒为 false，判断无头请用 DisplayServer.get_name()。
window/stretch/mode="canvas_items"
; aspect 与 canvas_items 配套；运行时切到 disabled 后失效（保留仅为便于回退）。
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/themes/default_theme.tres"


; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="末法纪元：最后的守护者"
config/description="2D 等距斜角（isometric）单机实时战斗 ARPG。引擎：Godot 4，语言：GDScript。"
config/version="0.1.0-dev1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Localization="*res://autoload/localization.gd"
GameState="*res://autoload/game_state.gd"
DataLoader="*res://autoload/data_loader.gd"
SaveManager="*res://autoload/save_manager.gd"
QuestService="*res://autoload/quest_service.gd"
MapService="*res://autoload/map_service.gd"
AudioCues="*res://autoload/audio_cues.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/camp_map_editor/plugin.cfg")

[gui]

theme/custom="res://assets/themes/default_theme.tres"

